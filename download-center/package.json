{
  "name": "@local/download-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sidebar download center with a download button in the right-sidebar file preview.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhoufu-exp/DSH-plugins.git",
    "directory": "download-center"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "download",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "ui",
      "summary": {
        "en": "Adds a Download Center panel to the left sidebar and a download button to the right-sidebar file preview, with an in-page history of the files you saved.",
        "zh": "在左侧栏加入「下载中心」面板，并为右侧文件预览加上下载按钮，记录本次页面内保存过的文件。"
      },
      "capabilities": [
        "slots",
        "locale",
        "workspace-files"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  }
}
