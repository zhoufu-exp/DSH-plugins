{
  "name": "dsh-workspace-editor",
  "version": "1.0.0",
  "type": "module",
  "description": "Edit UTF-8 text files in the right-sidebar file browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhoufu-exp/DSH-plugins.git",
    "directory": "workspace-editor"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "editor",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "ui",
      "summary": {
        "en": "Edits UTF-8 text files in the right-sidebar file browser, with version-checked saves, external-change prompts and local drafts.",
        "zh": "在右侧栏文件浏览器中直接编辑 UTF-8 文本文件，保存带版本校验，外部改动会提示，未保存内容保留为本地草稿。"
      },
      "capabilities": [
        "slots",
        "locale",
        "workspace-files",
        "file-write",
        "drafts"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  }
}
